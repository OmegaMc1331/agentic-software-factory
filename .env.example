# FACTORY_PROVIDER=local
# Set to "local" to use the deterministic built-in planner (no API key needed).
# Otherwise set to "openai" (or omit and export FACTORY_API_KEY).

# FACTORY_BASE_URL=https://api.openai.com/v1
# Any OpenAI-compatible chat completions endpoint.

# FACTORY_API_KEY=
# Required by `factory run` unless FACTORY_PROVIDER=local.

# FACTORY_MODEL=gpt-4o-mini