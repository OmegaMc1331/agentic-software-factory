# Agentic Software Factory has no model-provider settings.
#
# Agents are external coding CLIs (Codex, Claude Code, OpenCode, ...) that you install
# and authenticate yourself. The factory spawns them as subprocesses.
#
# Configure agents and roles in .factory/config.toml (created by `factory init`):
#
#   [agents.codex]
#   command = "codex"
#   args = ["exec"]
#
#   [roles.planner]
#   agent = "codex"
#
# Run `factory agents` to verify your agents are on PATH, and `factory config list` to
# see the resolved role-to-agent mapping. No environment variables are required.
