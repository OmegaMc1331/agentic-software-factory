# Agentic Software Factory has no model-provider settings.
#
# Agents are external coding CLIs (Codex, Claude Code, OpenCode, ...) that you install
# and authenticate yourself. The factory spawns them as subprocesses.
#
# Configure agents and roles in .factory/config.toml (created by `factory init`), or
# from the dashboard's Settings tab:
#
#   [agents.codex]
#   command = "codex"
#   args = ["exec"]
#
#   [roles.planner]
#   agent = "codex"
#
# Run `factory dev agents` to verify your agents are on PATH. No environment variables
# are required.